  "history": [
    {
      "version": "0.3.7",
      "publishedAt": "2026-11-18T12:14:23.562362+00:00",
      "changes": [
        "歌词可与歌曲信息一起匹配，B 站收藏夹支持多选。",
        "离线时可在原歌单播放已缓存的歌曲。",
        "电脑和平板新增定时停止播放，听歌统计新增聆听偏好词云。",
        "长评论可折叠，时间戳可跳转，视频支持付费、抢先看和充电专属标注。",
        "改进 iOS 播放与系统歌词、鸿蒙沉浸布局和蓝牙车机控制。"
      ]
    },
    {
      "version": "0.3.6",
      "publishedAt": "2026-11-17T12:42:30.253959+00:00",
      "changes": [
        "新增可选响度均衡，改善视频之间的音量差异。",
        "优化歌单导入与热门视频匹配，支持换源、重试和批量匹配歌曲信息与歌词。",
        "合集支持分类浏览、隐藏视频与分 P，续播自动定位所属分类。",
        "改进随机播放、长音视频起播与后台恢复，修复部分歌词显示问题。",
        "优化音乐库画廊、歌曲信息显示和安卓平板歌词页。"
      ]
    },
    {
      "version": "0.3.5",
      "publishedAt": "2026-11-16T13:44:59.420507+00:00",
      "changes": [
        "优化歌词识别、AI 字幕自动对齐和长标题显示，整理手机歌词页布局。",
        "改进坚果云同步调度与限流重试，减少请求次数。",
        "修复断点续播、进度拖动及视频恢复问题，提高播放稳定性。",
        "完善歌单导入容错、桌面窗口与托盘行为，优化大屏遥控器导航。",
        "新增 Intel Mac、Windows ARM64 安装包及 Linux 测试版，支持应用内下载安装更新。"
      ]
    },
    {
      "version": "0.3.4",
      "publishedAt": "2026-11-15T21:40:05.639662+08:00",
      "summary": "新增车机与 TV 大屏版，完善导入与播放体验。",
      "changes": [
        "新增独立大屏版，支持车机与 TV 的触控、遥控器、歌词、视频和弹幕。",
        "在线歌单导入统一支持网易云、QQ 音乐、酷狗、酷我和咪咕，优化匹配、续传及批量同步。",
        "改善续播、切歌预缓存与返回定位，统一分 P 标题和封面显示。",
        "优化桌面播放队列、托盘与歌词窗口，完善下载、快捷键及界面细节。"
      ]
    },
    {
      "version": "0.3.3",
      "title": "首次同步与播放修复",
      "summary": "修复坚果云首次同步失败，改善播放恢复与安卓下载。",
      "publishedAt": "2026-11-15T04:24:53.809252+00:00",
      "changes": [
        "修复新用户首次连接坚果云失败，完善同步错误提示与处理建议。",
        "改善断点续播、移动端后台切歌和音频中断后的恢复。",
        "安卓支持选择下载保存文件夹，并导出已有下载。"
      ]
    },
    {
      "version": "0.3.2",
      "title": "更轻量的同步，更顺手的音乐库",
      "summary": "重做坚果云增量同步，加入收藏排序，优化起播和多端操作。",
      "publishedAt": "2026-11-14T14:52:18.988036+00:00",
      "changes": [
        "升级坚果云增量同步，减少重复传输，自动合并大多数差异并汇总多端听歌统计。",
        "收藏与歌单支持拖动整理并同步顺序，列表内支持多种排序规则和倒序。",
        "打开关联 B 站收藏夹时后台刷新，支持批量导入收藏夹，改进 QQ 歌单导入。",
        "优化高码率起播与播放中断后的恢复，支持按视频时长调整断点续播阈值。",
        "完善桌面全局快捷键和应用唤出，修复 macOS 稳定性问题。",
        "优化听歌统计、移动端交互及 Android 图标与悬浮歌词设置。",
        "移除本地音乐导入，保留已下载歌曲的离线播放。"
      ]
    },
    {
      "version": "0.3.1",
      "title": "播放、歌词与音乐库体验升级",
      "publishedAt": "2026-11-13T16:00:00Z",
      "changes": [
        "优化起播、断线恢复与后台续播，切换音质时保持播放。",
        "支持 Hi-Res 无损音质；下载可独立选择音质与格式，更多页面可直接下载。",
        "新增双行悬浮歌词、逐字高亮和长句滚动，支持字号、配色与锁定；完善手机系统歌词显示。",
        "桌面快捷键支持自定义单键、组合键和鼠标侧键。",
        "统一歌单与 B 站关联收藏夹入口，新增列表搜索及关联清单跨端同步。",
        "完善评论回复与表情预览，修复移动端键盘、歌词居中和手势问题。",
        "统一设置、云同步和缓存管理样式，补充视频发布日期与合集数量。",
        "修复 Android 通知栏及耳机控制、macOS 窗口恢复与悬浮歌词稳定性，完善鸿蒙播放与封面显示。"
      ],
      "summary": "升级音质与下载、悬浮歌词和音乐库，完善五端播放与交互体验。"
    },
    {
      "version": "0.3.0",
      "kind": "major",
      "summary": "从 0.2.8 到 0.3.0，歌单导入、跨设备听歌统计、歌词与播放体验一起升级。macOS、Windows、Android 和 iOS 四端同步更新。",
      "changes": [
        "2026-11-13 新增鸿蒙 NEXT ARM64 测试版：提供未签名 HAP，真机需使用自己的华为开发者账号签名安装。",
        "2026-11-12 同步修复重打包：修复导入歌单及其成员被误报“同步记录身份无效”，保留原歌单编号和内容。",
        "坚果云 HTTP 401 提示使用应用密码重新连接；HTTP 403 单独显示访问被拒绝，避免误报授权失效并暂停同步。",
        "修复包文件名含 sync-fix，版本仍为 0.3.0；已安装 0.3.0 的用户请重新下载覆盖安装，同版本修复不会触发升级提示。",
        "从网易云、QQ 音乐或文本导入歌单，自动匹配 B 站视频与分 P；支持并发匹配、暂停续导和逐曲重新匹配。",
        "同一 B 站账号通过坚果云汇总各端听歌时长，支持离线补传；新增周、月、年及累计统计、歌曲排行和聆听热力日历。",
