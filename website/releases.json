  "history": [
    {
      "version": "0.4.2",
      "publishedAt": "2026-11-21T06:32:43.952922+00:00",
      "kind": "release",
      "changes": [
        "支持导入 B 站已订阅合集及桌面本地音乐文件夹，批量下载会跳过隐藏分 P。",
        "重排搜索结果，桌面支持单列和双列。优化平板首页，修复收藏库切换时按钮跳动。",
        "修复 Android 播放被打断后无法续播的问题，完善系统通知歌词。",
        "新增悬浮歌词居中排版，优化听歌统计、主题切换和扫码登录。"
      ]
    },
    {
      "version": "0.4.1",
      "publishedAt": "2026-11-20T08:47:28.704617+00:00",
      "kind": "major",
      "changes": [
        "改善 AI 字幕语言匹配、歌词自动校准和小窗歌词。",
        "Android 更新后台播放服务，改善通知、蓝牙控制和后台歌词。",
        "优化车机矮屏布局和视频起播，细化播放失败提示。",
        "修复鸿蒙离线状态误判。"
      ]
    },
    {
      "version": "0.4.0",
      "publishedAt": "2026-11-19T10:21:54.501267+00:00",
      "kind": "major",
      "changes": [
        "修复 Android 手机和平板上部分蓝牙耳机按键无法控制播放的问题。",
        "改善 iQOO 等 Android 机型通知栏播放器的显示。",
        "优化移动端手势、长列表加载和页面切换，听歌统计支持左右滑动。",
        "修复全屏视频错位和单 P 标题，优化视频加载、平板播放和评论回复的过渡。",
        "macOS 和 Windows 新增托盘播放器，Android 和电脑端桌面歌词可恢复位置。",
        "新增同步异常修复入口，各平台可独立接收更新。"
      ]
    },
    {
      "version": "0.3.7",
      "publishedAt": "2026-11-18T12:14:23.562362+00:00",
      "changes": [
        "原歌单支持离线播放已缓存歌曲，电脑和平板补齐定时暂停。",
        "B 站收藏夹可多选，歌词和歌曲资料可一并匹配。",
        "改进搜索和评论，增加付费、抢先看与充电专属标识。",
        "新增聆听偏好词云，桌面全局快捷键可按需开启。",
        "改进 iOS 播放、鸿蒙沉浸布局与音量，以及车机蓝牙和大屏适配。"
      ]
    },
    {
      "version": "0.3.6",
      "publishedAt": "2026-11-17T12:42:30.253959+00:00",
      "changes": [
        "新增可选响度均衡，改善视频之间的音量差异。",
        "优化歌单导入与热门视频匹配，支持换源、重试和批量匹配歌曲信息与歌词。",
        "合集支持分类浏览、隐藏视频与分 P，续播自动定位所属分类。",
        "改进随机播放、长音视频起播与后台恢复，修复部分歌词显示问题。",
        "优化音乐库画廊、歌曲信息显示和安卓平板歌词页。"
      ]
    },
    {
      "version": "0.3.5",
      "publishedAt": "2026-11-16T13:44:59.420507+00:00",
      "changes": [
        "优化歌词识别、AI 字幕自动对齐和长标题显示，整理手机歌词页布局。",
        "改进坚果云同步调度与限流重试，减少请求次数。",
        "修复断点续播、进度拖动及视频恢复问题，提高播放稳定性。",
        "完善歌单导入容错、桌面窗口与托盘行为，优化大屏遥控器导航。",
        "新增 Intel Mac、Windows ARM64 安装包及 Linux 测试版，支持应用内下载安装更新。"
      ]
    },
    {
      "version": "0.3.4",
      "publishedAt": "2026-11-15T21:40:05.639662+08:00",
      "summary": "新增车机与 TV 大屏版，完善导入与播放体验。",
      "changes": [
        "新增独立大屏版，支持车机与 TV 的触控、遥控器、歌词、视频和弹幕。",
        "在线歌单导入统一支持网易云、QQ 音乐、酷狗、酷我和咪咕，优化匹配、续传及批量同步。",
        "改善续播、切歌预缓存与返回定位，统一分 P 标题和封面显示。",
        "优化桌面播放队列、托盘与歌词窗口，完善下载、快捷键及界面细节。"
      ]
    },
    {
      "version": "0.3.3",
      "title": "首次同步与播放修复",
      "summary": "修复坚果云首次同步失败，改善播放恢复与安卓下载。",
      "publishedAt": "2026-11-15T04:24:53.809252+00:00",
      "changes": [
        "修复新用户首次连接坚果云失败，完善同步错误提示与处理建议。",
        "改善断点续播、移动端后台切歌和音频中断后的恢复。",
        "安卓支持选择下载保存文件夹，并导出已有下载。"
      ]
    },
    {
      "version": "0.3.2",
      "title": "更轻量的同步，更顺手的音乐库",
      "summary": "重做坚果云增量同步，加入收藏排序，优化起播和多端操作。",
      "publishedAt": "2026-11-14T14:52:18.988036+00:00",
      "changes": [
        "升级坚果云增量同步，减少重复传输，自动合并大多数差异并汇总多端听歌统计。",
