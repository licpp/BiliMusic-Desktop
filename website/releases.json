  "history": [
    {
      "version": "0.4.6",
      "publishedAt": "2026-11-27T07:27:08.770614+00:00",
      "kind": "release",
      "changes": [
        "安卓手机和平板支持 WebView 91 及以上版本。",
        "修复 Android 网易云音乐登录闪退，优化音质切换。",
        "下载支持批量删除，丢失的文件可恢复或重下。",
        "最近搜索占用更少空间，导入歌单支持拖动排序和跨设备同步。",
        "新增「设置 → 扩展」，推荐和热搜可按需开启，默认保留简洁搜索。",
        "「探索」汇集每日推荐、B 站推荐与三个平台的热搜。",
        "歌词滚动更流畅，封面先显示缩略图再切换大图，支持移除歌词和更大的偏移。",
        "关联收藏夹增加常用歌曲操作，关注文件夹可自选图案和颜色。",
        "支持跟随系统主题。车机新增推荐和导入，单 P 可直接播放，多 P 可查看分集。"
      ]
    },
    {
      "version": "0.4.5",
      "publishedAt": "2026-11-25T14:26:26.595980+00:00",
      "kind": "release",
      "changes": [
        "车机版支持导入 B 站收藏夹、订阅合集和关注。修复旧 WebView 下的设置与播放栏排版，启动时提示升级低于 66 的 WebView。",
        "Android 手机和平板可在悬浮歌词上直接切换原文、译文和双语，并记住选择。",
        "歌单和「我喜欢」支持拖动排序、更换视频和自动查重，顺序可跨端同步。",
        "自动记住播放倍速。桌面歌词支持原文、译文和双语。",
        "优化电脑和平板歌词页动效，修复手机拖动排序、弹窗遮挡和桌面「我喜欢」列表加载。",
        "改善 Android 通知栏续播、缓存音频恢复和旧车机 WebView 下的视频与歌词显示。"
      ]
    },
    {
      "version": "0.4.4",
      "publishedAt": "2026-11-24T10:10:04.319756+00:00",
      "kind": "release",
      "changes": [
        "支持 B 站官方章节和评论章节，可编辑并跨设备同步。",
        "关联收藏夹支持批量匹配与断点续跑，合集分别记住播放进度。",
        "优化队列拖动、响度均衡和电脑歌词页切换。",
        "改进 Android 蓝牙耳机续播与车机旧版 WebView 显示。"
      ]
    },
    {
      "version": "0.4.3",
      "publishedAt": "2026-11-23T06:52:59.381391+00:00",
      "kind": "release",
      "changes": [
        "修复启动闪退、安卓受打断后无法继续播放，以及 iOS 重复提示更新。",
        "自动跳过失效视频，新增启动自动播放。下载列表可分批浏览全部记录。",
        "优化平板双栏搜索、歌词页开合与移动端全屏播放。",
        "各端设置支持复制本机环境，播放报错提供具体阶段和错误码。"
      ]
    },
    {
      "version": "0.4.2",
      "publishedAt": "2026-11-21T06:32:43.952922+00:00",
      "kind": "release",
      "changes": [
        "车机版合并为 32 / 64 位通用包，修复旧版 WebView 下页面、封面和队列显示异常。",
        "Debian 安装包补齐启动所需依赖。",
        "导入歌单可逐首移除未匹配歌曲。",
        "支持用 B 站链接或 BV 号精确搜索，清空搜索后光标留在搜索框。",
        "修复部分音频无法播放及切换无损音质时进度回退。",
        "优化移动端粘贴、平板歌词动画和收藏多选，新增 Windows 任务栏播放控制。",
        "支持导入 B 站已订阅合集及桌面本地音乐文件夹，批量下载会跳过隐藏分 P。",
        "重排搜索结果，桌面支持单列和双列。优化平板首页，修复收藏库切换时按钮跳动。",
        "修复 Android 播放被打断后无法续播的问题，完善系统通知歌词。",
        "新增悬浮歌词居中排版，优化听歌统计、主题切换和扫码登录。"
      ]
    },
    {
      "version": "0.4.1",
      "publishedAt": "2026-11-20T08:47:28.704617+00:00",
      "kind": "major",
      "changes": [
        "改善 AI 字幕语言匹配、歌词自动校准和小窗歌词。",
        "Android 更新后台播放服务，改善通知、蓝牙控制和后台歌词。",
        "优化车机矮屏布局和视频起播，细化播放失败提示。",
        "修复鸿蒙离线状态误判。"
      ]
    },
    {
      "version": "0.4.0",
      "publishedAt": "2026-11-19T10:21:54.501267+00:00",
      "kind": "major",
      "changes": [
        "修复 Android 手机和平板上部分蓝牙耳机按键无法控制播放的问题。",
        "改善 iQOO 等 Android 机型通知栏播放器的显示。",
        "优化移动端手势、长列表加载和页面切换，听歌统计支持左右滑动。",
        "修复全屏视频错位和单 P 标题，优化视频加载、平板播放和评论回复的过渡。",
        "macOS 和 Windows 新增托盘播放器，Android 和电脑端桌面歌词可恢复位置。",
        "新增同步异常修复入口，各平台可独立接收更新。"
      ]
    },
    {
      "version": "0.3.7",
      "publishedAt": "2026-11-18T12:14:23.562362+00:00",
