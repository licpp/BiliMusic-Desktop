  "history": [
    {
      "version": "0.2.6",
      "publishedAt": "2026-11-10T13:26:57.553716+00:00",
      "changes": [
        "四端支持播放倍速。手机上可拖动刻度选择速度，视频、歌词和字幕会跟随播放进度。",
        "自动断点续播默认开启，可在设置里关闭。也可在曲目菜单手动续播。",
        "开启同步播放记录后，最近 200 首在线曲目的断点可以在设备间接续。",
        "手机播放设置改为底部面板，音质和字幕版本可滑动选择。"
      ]
    },
    {
      "version": "0.2.5",
      "publishedAt": "2026-11-10T11:52:55.720664+00:00",
      "changes": [
        "合集和分 P 列表更清晰，打开合集或队列时会定位到当前曲目。",
        "收藏合集支持继续上次播放，开启同步播放记录后，可在设备间接着听。",
        "手机新增睡眠定时，搜索、评论和播放页操作更顺手。",
        "最近播放按时间排序，临时断线会自动重试，并调整了横封面和播放标记。"
      ]
    },
    {
      "version": "0.2.4",
      "publishedAt": "2026-11-09T14:35:53.900806+00:00",
      "changes": [
        "播放页可直接打开 B 站合集，支持倒序播放、收藏和复制成歌单。",
        "听书和长视频可开启 B 站 AI 字幕，也能选择音质、画质和弹幕密度。",
        "改进音乐和视频起播，手机全屏、评论返回和播放进度更顺手。",
        "「我的」新增本机听歌统计，可查看本周和累计时长。"
      ]
    },
    {
      "version": "0.2.3",
      "publishedAt": "2026-11-08T10:48:53.882247Z",
      "changes": [
        "手机播放页更清爽，封面与视频切换时歌词位置保持不变。",
        "安卓支持滑动切歌、长按菜单，重新整理播放队列和评论回复。",
        "播放时自动匹配歌词，改善播放响应并修复评论点赞等问题。",
        "新增 iOS 自签版下载，安卓通知栏可以显示专辑封面。"
      ]
    },
    {
      "version": "0.2.2",
      "publishedAt": "2026-11-07T04:04:58Z",
      "changes": [
        "修复搜索结果展开分 P 时意外切歌的问题，单分 P 也能展开查看。",
        "收起后再次展开会保留已加载内容，加载失败后可以重新尝试。"
      ]
    },
    {
      "version": "0.2.1",
      "publishedAt": "2026-11-07T03:23:31Z",
      "changes": [
        "修复点击「登录 B 站账号」时跳回首页的问题，现在可以在当前页面扫码登录。"
      ]
    },
    {
      "version": "0.2.0",
      "publishedAt": "2026-11-06T16:41:50Z",
      "changes": [
        "自建和 B 站同步的收藏夹统一成列表，封面取自第一条视频。",
        "默认收藏直接显示，拖动视频就能放入自建收藏夹。",
        "进入关联收藏夹会自动同步，复制的收藏夹会放进「我的歌单」。",
        "搜索和收藏里的分 P 可以多选，批量下载或加入歌单。"
      ]
    },
    {
      "version": "0.1.10",
      "changes": [
        "点搜索框里的 ×，就能回到搜索首页。",
        "一次选多首歌，批量下载、加入歌单或播放队列。",
        "Windows 和 Mac 可以导入电脑里的歌曲。",
        "B 站收藏夹可以关联同步，也可以复制成自己的歌单。"
      ],
      "publishedAt": "2026-11-06T15:20:09Z"
    },
    {
      "version": "0.1.9",
      "publishedAt": "2026-10-30T07:01:55Z",
      "changes": [
        "可以收藏整套合集，再展开选歌或选章节。",
        "安卓首页可以继续聆听，也能直接管理歌单和收藏。",
        "从列表点歌后，可以顺着同一个列表接着听。"
      ]
    },
    {
      "version": "0.1.7",
      "publishedAt": "2026-10-29T08:07:40Z",
      "changes": [
        "应用内可以检查更新。",
        "切换页面时保留搜索结果，歌曲信息也更容易匹配。",
        "安卓评论改成更好操作的底部面板。"
      ]
    },
    {
      "version": "0.1.6-preview.7",
