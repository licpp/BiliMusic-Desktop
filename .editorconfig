# 与 .gitattributes 保持一致：文本文件默认使用 LF 和 UTF-8。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Windows 批处理保留 CRLF。
[*.{bat,cmd}]
end_of_line = crlf

# Rust、Kotlin、Swift 和 Python 的现有代码都使用 4 空格缩进。
[*.{rs,kt,kts,java,swift,py}]
indent_size = 4

# Markdown 用行尾空格表示换行，不做清理。
[*.md]
trim_trailing_whitespace = false
