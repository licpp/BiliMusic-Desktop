{
  "name": "bilimusic-desktop",
  "private": true,
  "version": "0.4.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:rust": "node scripts/rust-test.mjs",
    "test:sync": "node scripts/test-sync.mjs",
    "test:sync:stress": "node scripts/test-sync.mjs --stress",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "android:init": "tauri icon assets/android/icon.json --output src-tauri/.android-icons && tauri android init --ci --skip-targets-install && node scripts/android-prepare.mjs",
    "android:dev": "tauri android dev",
    "android:build": "node scripts/mobile-version.mjs android && node scripts/android-prepare.mjs && npm run tauri -- android build --apk --target aarch64",
    "android:local": "node scripts/android-local.mjs",
    "ios:init": "tauri ios init --ci --skip-targets-install && npm run ios:prepare",
    "ios:prepare": "node scripts/ios-prepare.mjs",
    "ios:dev": "npm run ios:prepare && tauri ios dev",
    "ios:build": "node scripts/mobile-version.mjs ios && npm run ios:prepare && npm run tauri -- ios build --ci --target aarch64 --no-sign --archive-only && node scripts/ios-package.mjs",
    "ohos:tools": "node scripts/ohos.mjs tools",
    "ohos:prepare": "node scripts/ohos.mjs prepare",
    "ohos:check": "node scripts/ohos.mjs check",
    "ohos:init": "node scripts/ohos.mjs init",
    "ohos:build": "node scripts/ohos.mjs build",
    "dev:large-screen": "vite --mode large-screen",
    "build:large-screen": "tsc --noEmit && vite build --mode large-screen",
    "android:large-screen": "node scripts/android-local.mjs large-screen",
    "build:updater": "node scripts/build-updater.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.89.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-store": "^2.4.4",
    "core-js": "^3.51.0",
    "lucide-react": "^0.544.0",
    "opencc-js": "1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
