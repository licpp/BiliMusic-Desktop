{
  "name": "bilimusic-desktop",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "android:init": "tauri icon public/app-icon.png --output src-tauri/.android-icons && tauri android init --ci --skip-targets-install && node scripts/android-prepare.mjs",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --target aarch64",
    "ios:init": "tauri icon public/app-icon.png --output src-tauri/.ios-icons && tauri ios init --ci --skip-targets-install && node scripts/ios-prepare.mjs",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build --ci --target aarch64 --no-sign --archive-only && node scripts/ios-package.mjs",
    "ohos:tools": "node scripts/ohos.mjs tools",
    "ohos:prepare": "node scripts/ohos.mjs prepare",
    "ohos:check": "node scripts/ohos.mjs check",
    "ohos:init": "node scripts/ohos.mjs init",
    "ohos:build": "node scripts/ohos.mjs build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.89.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-store": "^2.4.4",
    "lucide-react": "^0.544.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
